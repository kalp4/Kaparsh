import io
import json
from fastapi import FastAPI, UploadFile, File, Form, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from pypdf import PdfReader
from google import genai
from google.genai import types

app = FastAPI(title="EduCoPilot API")

# Enable CORS for frontend integration
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# --- Pydantic Models for Request Validation ---

class ScheduleRequest(BaseModel):
    topics: list
    exam_date: str
    study_hours: float
    api_key: str

class QuizRequest(BaseModel):
    topics: list
    api_key: str

# --- Helper Function ---

def get_gemini_client(api_key: str):
    """Instantiates the Gemini client with the provided API key."""
    if not api_key:
        raise HTTPException(status_code=400, detail="Gemini API Key is required.")
    try:
        return genai.Client(api_key=api_key)
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Invalid API Key or Client Error: {str(e)}")

# --- Endpoints ---

@app.post("/api/analyze")
async def analyze_pdf(
    file: UploadFile = File(...),
    api_key: str = Form(...)
):
    if not file.filename.lower().endswith(".pdf"):
        raise HTTPException(status_code=400, detail="Only PDF files are supported.")
        
    try:
        contents = await file.read()
        reader = PdfReader(io.BytesIO(contents))
        text = ""
        
        # Limit to the first 15 pages to ensure it stays within serverless timeouts and context windows
        for page in reader.pages[:15]:
            extracted = page.extract_text()
            if extracted:
                text += extracted + "\n"
                
        if not text.strip():
            raise HTTPException(status_code=400, detail="Could not extract any readable text from the provided PDF.")
            
        client = get_gemini_client(api_key)
        
        prompt = (
            "You are an expert AI study assistant. Analyze the following educational text "
            "and extract the core topics. Provide a clear, concise definition for each topic.\n\n"
            "Return ONLY a JSON object with this exact structure (no markdown blocks, no extra text):\n"
            "{\n"
            '  "topics": [\n'
            '    {"topic": "Topic Name", "definition": "Clear explanation of the topic"}\n'
            "  ]\n"
            "}\n\n"
            f"Text to analyze:\n{text[:25000]}"
        )
        
        response = await client.aio.models.generate_content(
            model='gemini-2.0-flash',
            contents=prompt,
            config=types.GenerateContentConfig(
                response_mime_type="application/json",
                temperature=0.2,
            )
        )
        
        return json.loads(response.text)
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"PDF Analysis failed: {str(e)}")


@app.post("/api/schedule")
async def generate_schedule(req: ScheduleRequest):
    try:
        client = get_gemini_client(req.api_key)
        topics_json = json.dumps(req.topics)
        
        prompt = (
            f"You are an expert study planner. Create a day-by-day revision schedule.\n"
            f"Exam Date: {req.exam_date}\n"
            f"Daily Study Hours available: {req.study_hours}\n"
            f"Topics to cover: {topics_json}\n\n"
            "Distribute the topics logically over the days leading up to the exam. "
            "Return ONLY a JSON object with this exact structure (no markdown blocks):\n"
            "{\n"
            '  "schedule": [\n'
            '    {"day": 1, "date": "YYYY-MM-DD", "topics_to_study": ["Topic 1", "Topic 2"], "hours_allocated": 2.5, "strategy": "Active recall..."}\n'
            "  ]\n"
            "}"
        )
        
        response = await client.aio.models.generate_content(
            model='gemini-2.0-flash',
            contents=prompt,
            config=types.GenerateContentConfig(
                response_mime_type="application/json",
                temperature=0.3,
            )
        )
        
        return json.loads(response.text)
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Schedule generation failed: {str(e)}")


@app.post("/api/quiz")
async def generate_quiz(req: QuizRequest):
    try:
        client = get_gemini_client(req.api_key)
        topics_json = json.dumps(req.topics)
        
        prompt = (
            "You are an expert educator. Create 3 multiple-choice practice questions based on these topics to test the student's understanding.\n"
            f"Topics: {topics_json}\n\n"
            "Return ONLY a JSON object with this exact structure (no markdown blocks):\n"
            "{\n"
            '  "quiz": [\n'
            '    {\n'
            '      "question": "What is...?",\n'
            '      "options": ["A", "B", "C", "D"],\n'
            '      "correct_answer": "The exact string of the correct option (e.g., A)",\n'
            '      "explanation": "Why this is correct..."\n'
            '    }\n'
            "  ]\n"
            "}"
        )
        
        response = await client.aio.models.generate_content(
            model='gemini-2.0-flash',
            contents=prompt,
            config=types.GenerateContentConfig(
                response_mime_type="application/json",
                temperature=0.3,
            )
        )
        
        return json.loads(response.text)
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Quiz generation failed: {str(e)}")

if os.path.exists("public"):
    app.mount("/", StaticFiles(directory="public", html=True), name="static")
